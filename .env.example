# Browser-safe Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only provider credentials used by api/sentinel.js
APIFY_API_KEY=apify_api_...
NVIDIA_API_KEY=nvapi-...

# Optional model chain and per-attempt timeout for Sentinel research.
# Models are tried from left to right; each attempt is recorded in the visual log.
SENTINEL_MODELS=openai/gpt-oss-20b,z-ai/glm-5.2
SENTINEL_MODEL_TIMEOUT_MS=45000
SENTINEL_ADJACENT_PAGES=2
SENTINEL_SOURCE_CHAR_LIMIT=24000

# Optional fallback for server deployments without the publishable key above.
# Local development and normal deployments use the user's JWT + Supabase RLS.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Optional — só usadas pelo botão "Enriquecer" na tela Web (fase 3, manual,
# roda depois que a IA já aprovou uma oportunidade). Sem elas, o botão ainda
# funciona, só que a busca daquele serviço específico falha e some do
# resultado — as outras continuam normais.
SERPER_API_KEY=...
YOUTUBE_API_KEY=...
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
DATABASE_URL=
VITE_BEEHIIV_API_KEY=
VITE_BEEHIIV_PUBLICATION_ID=
NVIDIA_API_KEY=
NOTION_API=
APIFY_API_KEY=
